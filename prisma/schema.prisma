generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["agenda", "catalogos", "cursos", "seguridad", "sistema", "ventas"]
}

model Cita {
  id                   Int          @id @default(autoincrement())
  usuario_id           Int?
  servicio_id          Int
  fecha                DateTime
  hora                 String
  notas                String?
  createdAt            DateTime     @default(now())
  metodo_pago          String?
  nombre_contacto      String?
  telefono_contacto    String?
  empleado_id          Int?
  estado               String       @default("PENDIENTE")
  recordatorio_enviado Boolean      @default(false)
  total                Decimal?     @db.Decimal(10, 2)
  cancelado_en         DateTime?
  cancelado_por        String?
  recordatorio_alexa   Boolean?
  estado_cita          String       @default("PENDIENTE")
  comprobante          String?      @db.Text
  empleado             Usuario?     @relation("CitaEmpleado", fields: [empleado_id], references: [id])
  servicio             Servicio     @relation(fields: [servicio_id], references: [id])
  usuario              Usuario?     @relation("CitaCliente", fields: [usuario_id], references: [id])
  avisos               AvisoAdmin[]

  @@index([fecha],        map: "idx_citas_fecha")
  @@index([estado],       map: "idx_citas_estado")
  @@index([usuario_id],   map: "idx_citas_usuario")
  @@index([empleado_id],  map: "idx_citas_empleado")
  @@index([fecha, estado],map: "idx_citas_fecha_estado")
  @@map("tblcitas")
  @@schema("agenda")
}

model DiaBloqueado {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @db.Date
  motivo    String?
  createdAt DateTime @default(now())

  @@map("tbldias_bloqueados")
  @@schema("agenda")
}

model HorarioDisponible {
  id        Int     @id @default(autoincrement())
  hora      String
  activo    Boolean @default(true)
  diaSemana Int     @default(1)

  @@unique([hora, diaSemana])
  @@map("tblhorarios")
  @@schema("agenda")
}

model HorarioExcepcion {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @db.Date
  hora   String
  motivo String?

  @@unique([fecha, hora])
  @@map("tblhorarios_excepciones")
  @@schema("agenda")
}

model HoraBloqueada {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @db.Date
  hora   String
  motivo String?

  @@unique([fecha, hora])
  @@map("tblhoras_bloqueadas")
  @@schema("agenda")
}

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(100)
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("tblmarcas")
  @@schema("catalogos")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(100)
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("tblcategorias")
  @@schema("catalogos")
}

model Producto {
  id                  Int                 @id @default(autoincrement())
  nombre              String              @db.VarChar(150)
  descripcion         String?
  marca_id            Int?
  categoria_id        Int?
  activo              Boolean?            @default(true)
  fecha_creacion      DateTime?           @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime?           @default(now()) @db.Timestamp(6)
  imagen              Json?
  codigo              String?             @unique(map: "uq_producto_codigo") @db.VarChar(50)
  precio_costo        Decimal?            @db.Decimal(10, 2)
  precio_venta        Decimal?            @db.Decimal(10, 2)
  stock               Int                 @default(0)
  favoritos           Favorito[]
  categoria           Categoria?          @relation(fields: [categoria_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  marca               Marca?              @relation(fields: [marca_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  promociones         PromocionProducto[]
  variantes           Variante[]

  @@map("tblproductos")
  @@schema("catalogos")
}

model Variante {
  id                  Int             @id @default(autoincrement())
  producto_id         Int
  codigo              String?         @db.VarChar(50)
  tono                String?         @db.VarChar(100)
  presentacion        String?         @db.VarChar(50)
  precio_costo        Decimal         @db.Decimal(10, 2)
  precio_venta        Decimal         @db.Decimal(10, 2)
  stock               Int             @default(0)
  imagen              Json?
  activo              Boolean         @default(true)
  fecha_creacion      DateTime        @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime        @default(now()) @db.Timestamp(6)
  carrito             CarritoItem[]
  detalles            DetallePedido[]
  producto            Producto        @relation(fields: [producto_id], references: [id], onDelete: Cascade, map: "fk_variante_producto")

  @@unique([producto_id, tono, presentacion], map: "uq_variante_producto_tono_presentacion")
  @@index([activo], map: "idx_variantes_activo")
  @@index([producto_id], map: "idx_variantes_producto_id")
  @@map("tblvariantes")
  @@schema("catalogos")
}

model CarritoItem {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  variante_id    Int
  cantidad       Int       @default(1)
  creado_en      DateTime? @default(now()) @db.Timestamp(6)
  actualizado_en DateTime? @default(now()) @db.Timestamp(6)
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carrito_usuario")
  variante       Variante  @relation(fields: [variante_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carrito_variante")

  @@unique([usuario_id, variante_id])
  @@index([usuario_id], map: "idx_carrito_usuario")
  @@map("tblcarrito")
  @@schema("ventas")
}

model Favorito {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  producto_id Int
  creado_en   DateTime? @default(now()) @db.Timestamp(6)
  producto    Producto  @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_favorito_producto")
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_favorito_usuario")

  @@unique([usuario_id, producto_id])
  @@index([usuario_id], map: "idx_favoritos_usuario")
  @@map("tblfavoritos_productos")
  @@schema("ventas")
}

model Servicio {
  id           Int                @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Float
  duracion     String
  imagen       String?
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  beneficios   String?
  incluye      String?
  categoria_id Int?
  citas        Cita[]
  categoria    CategoriaServicio? @relation(fields: [categoria_id], references: [id])
  favoritos    FavoritoServicio[]

  @@map("tblservicios")
  @@schema("catalogos")
}

model FavoritoServicio {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  servicio_id Int
  creado_en   DateTime? @default(now()) @db.Timestamp(6)
  servicio    Servicio  @relation(fields: [servicio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, servicio_id])
  @@index([usuario_id])
  @@map("tblfavoritos_servicios")
  @@schema("ventas")
}

model FavoritoCurso {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  curso_id   Int
  creado_en  DateTime? @default(now()) @db.Timestamp(6)
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fav_curso_usuario")

  @@unique([usuario_id, curso_id], map: "uq_fav_curso")
  @@index([usuario_id], map: "idx_fav_cursos_usuario")
  @@map("tblfavoritos_cursos")
  @@schema("ventas")
}

model CategoriaServicio {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(100)
  activo    Boolean    @default(true)
  servicios Servicio[]

  @@map("tblcategorias_servicios")
  @@schema("catalogos")
}

model Curso {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique @db.VarChar(50)
  titulo         String    @db.VarChar(200)
  descripcion    String?
  precio_total   Decimal   @db.Decimal(10, 2)
  cupo_maximo    Int
  inscritos      Int       @default(0)
  duracion_horas Int?
  nivel          String?   @db.VarChar(50)
  activo         Boolean   @default(true)
  fecha_inicio   DateTime? @db.Date
  fecha_fin      DateTime? @db.Date
  created_at     DateTime  @default(now())
  imagenes       Json?
  inscripciones  Inscripcion[]

  @@map("tblcursos")
  @@schema("cursos")
}

model Inscripcion {
  id                Int      @id @default(autoincrement())
  usuario_id        Int
  curso_id          Int
  fecha_inscripcion DateTime @default(now())
  estado            String   @default("ACTIVO") @db.VarChar(50)
  curso             Curso    @relation(fields: [curso_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pagos             PagoCurso[]

  @@unique([usuario_id, curso_id], map: "uq_inscripcion_usuario_curso")
  @@map("tblinscripciones")
  @@schema("cursos")
}

model PagoCurso {
  id             Int      @id @default(autoincrement())
  inscripcion_id Int
  numero_pago    Int?
  monto          Decimal  @db.Decimal(10, 2)
  metodo_pago    String?  @db.VarChar(50)
  estado         String   @default("PAGADO") @db.VarChar(50)
  fecha_pago     DateTime @default(now())
  inscripcion    Inscripcion @relation(fields: [inscripcion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("tblpagos_curso")
  @@schema("cursos")
}

model Asistencia {
  id             Int      @id @default(autoincrement())
  inscripcion_id Int
  fecha          DateTime @db.Date
  presente       Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@unique([inscripcion_id, fecha], map: "uq_asistencia")
  @@map("tblasistencias")
  @@schema("cursos")
}

model AvisoAdmin {
  id         Int      @id @default(autoincrement())
  cita_id    Int
  usuario_id Int?
  mensaje    String
  leido      Boolean  @default(false)
  createdAt  DateTime @default(now())
  cita       Cita     @relation(fields: [cita_id], references: [id])
  usuario    Usuario? @relation(fields: [usuario_id], references: [id])

  @@map("tblavisos_admin")
  @@schema("sistema")
}

model TokenRecuperacion {
  id         Int      @id @default(autoincrement())
  usuario_id Int      @unique
  token      String   @unique
  expira     DateTime
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("tbltoken_recuperacion")
  @@schema("seguridad")
}

model Usuario {
  id                 Int                     @id @default(autoincrement())
  nombre             String                  @db.VarChar(150)
  correo             String                  @unique @db.VarChar(100)
  password           String                  @db.VarChar(255)
  telefono           String?                 @db.VarChar(20)
  rol                Rol                     @default(CLIENTE)
  activo             Boolean                 @default(true)
  intentos_fallidos  Int                     @default(0)
  cuenta_bloqueada   Boolean                 @default(false)
  fecha_registro     DateTime                @default(now()) @db.Timestamp(6)
  apmaterno          String?                 @db.VarChar(150)
  appaterno          String?                 @db.VarChar(150)
  image              String?
  citasComoEmpleado  Cita[]                  @relation("CitaEmpleado")
  citasComoCliente   Cita[]                  @relation("CitaCliente")
  avisos             AvisoAdmin[]
  diasAtencion       EmpleadoDia[]
  horaExcepciones    EmpleadoHoraExcepcion[]
  permisos           PermisoUsuario[]
  tokenRecuperacion  TokenRecuperacion?
  carrito            CarritoItem[]
  favoritos          Favorito[]
  favoritosCursos    FavoritoCurso[]
  favoritosServicios FavoritoServicio[]
  pedidos            Pedido[]
  correo_verificado  Boolean  @default(true)
  tokenVerificacion  TokenVerificacion?

  @@map("tblusuarios")
  @@schema("seguridad")
}

model TokenVerificacion {
  id         Int      @id @default(autoincrement())
  usuario_id Int      @unique
  token      String   @unique
  expira     DateTime
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("tbltoken_verificacion")
  @@schema("seguridad")
}

model Empleado {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  puesto      String   @db.VarChar(100)
  descripcion String?
  imagen      String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tblempleados")
  @@schema("catalogos")
}

model EmpleadoDia {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  dia_semana Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, dia_semana])
  @@map("tblempleado_dias")
  @@schema("agenda")
}

model EmpleadoHoraExcepcion {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  dia_semana Int?
  fecha      DateTime? @db.Date
  hora       String    @db.VarChar(5)
  tipo       String    @db.VarChar(10)
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, dia_semana, hora, tipo])
  @@unique([usuario_id, fecha, hora, tipo])
  @@map("tblempleado_hora_excepciones")
  @@schema("agenda")
}

model PermisoUsuario {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  permiso    String  @db.VarChar(100)
  activo     Boolean @default(false)
  usuario    Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, permiso])
  @@map("tblpermisos_usuario")
  @@schema("seguridad")
}

model DetallePedido {
  id              Int      @id @default(autoincrement())
  pedido_id       Int
  precio_unitario Decimal  @db.Decimal(10, 2)
  cantidad        Int
  subtotal        Decimal  @db.Decimal(10, 2)
  variante_id     Int
  variante        Variante @relation(fields: [variante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_variante")
  pedido          Pedido   @relation(fields: [pedido_id], references: [id])

  @@map("tbldetalle_pedidos")
  @@schema("ventas")
}

model Pedido {
  id               Int             @id @default(autoincrement())
  usuario_id       Int
  estado           EstadoPedido    @default(PENDIENTE)
  subtotal         Decimal         @db.Decimal(10, 2)
  costo_envio      Decimal         @default(0) @db.Decimal(10, 2)
  total            Decimal         @db.Decimal(10, 2)
  nombre_cliente   String          @db.VarChar(200)
  correo_cliente   String          @db.VarChar(100)
  telefono_cliente String?         @db.VarChar(20)
  fecha_pedido     DateTime        @default(now()) @db.Timestamp(6)
  metodo_pago      String?         @db.VarChar(50)
  comprobante_url  String?         @db.Text
  detalles         DetallePedido[]
  usuario          Usuario         @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id],              map: "idx_pedidos_usuario")
  @@index([estado],                  map: "idx_pedidos_estado")
  @@index([fecha_pedido],            map: "idx_pedidos_fecha")
  @@index([estado, fecha_pedido],    map: "idx_pedidos_estado_fecha")
  @@map("tblpedidos")
  @@schema("ventas")
}

model Promocion {
  id           Int                 @id @default(autoincrement())
  nombre       String              @db.VarChar(150)
  tipo         String              @db.VarChar(50)
  descuento    Decimal             @db.Decimal(5, 2)
  codigo       String?             @unique @db.VarChar(50)
  fecha_inicio DateTime            @db.Date
  fecha_fin    DateTime            @db.Date
  activo       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  productos    PromocionProducto[]

  @@map("tblpromociones")
  @@schema("ventas")
}

model PromocionProducto {
  id           Int       @id @default(autoincrement())
  promocion_id Int
  producto_id  Int
  producto     Producto  @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  promocion    Promocion @relation(fields: [promocion_id], references: [id], onDelete: Cascade)

  @@unique([promocion_id, producto_id])
  @@map("tblpromociones_productos")
  @@schema("ventas")
}

model ConfigSitio {
  id    Int    @id @default(autoincrement())
  clave String @unique @db.VarChar(100)
  valor String

  @@map("tblconfig_sitio")
  @@schema("sistema")
}

model PreguntaFrecuente {
  id        Int      @id @default(autoincrement())
  pregunta  String   @db.VarChar(300)
  respuesta String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tblfaq")
  @@schema("catalogos")
}

model Backup {
  id     Int       @id @default(autoincrement())
  nombre String    @db.VarChar(255)
  ruta   String
  tama_o String?   @map("tamaño") @db.VarChar(50)
  fecha  DateTime? @default(now()) @db.Timestamp(6)
  estado String?   @default("COMPLETADO") @db.VarChar(50)

  @@map("tblbackup")
  @@schema("sistema")
}

enum Rol {
  ADMIN
  DOCENTE
  EMPLEADO
  CLIENTE

  @@schema("seguridad")
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO

  @@schema("ventas")
}
